<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#8a1424" />
<title>Expected Final Grade Calculator</title>
<style>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#251b1c;background:#f8f6f4;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-height:100vh}button,input{font:inherit}button{cursor:pointer}.topbar{background:#831526;color:white;padding:20px max(22px,calc((100vw - 1120px)/2));display:flex;gap:14px;align-items:center}.logo{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:#fff2;font-weight:900;letter-spacing:-1px}.brand{font-weight:800;line-height:1.1}.brand small{display:block;opacity:.78;font-weight:500;font-size:12px;margin-top:5px}main{max-width:1120px;margin:auto;padding:34px 22px 80px}.intro{margin-bottom:26px}.eyebrow{color:#9f2a3a;text-transform:uppercase;letter-spacing:.15em;font-size:12px;font-weight:850}h1{font-size:clamp(28px,4vw,41px);letter-spacing:-.055em;margin:8px 0 10px;line-height:1.1}.intro p{color:#71686b;margin:0;line-height:1.6;max-width:740px}.layout{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(310px,.9fr);align-items:start;gap:22px}.card{background:#fff;border:1px solid #e9e1df;border-radius:20px;box-shadow:0 8px 30px #40111208;overflow:hidden}.cardHeader{padding:23px 25px 15px;border-bottom:1px solid #f0e9e7;display:flex;justify-content:space-between;align-items:center;gap:16px}.cardHeader h2{font-size:18px;margin:0;letter-spacing:-.025em}.cardHeader p{font-size:13px;color:#81777a;margin:6px 0 0}.body{padding:24px 25px}.sectionTitle{margin:22px 0 12px;font-weight:800;font-size:13px;color:#5f5155;letter-spacing:.03em}.sectionTitle:first-child{margin-top:0}.inputs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field{min-width:0}.field label{display:flex;align-items:center;justify-content:space-between;gap:4px;font-size:13px;font-weight:750;margin:0 0 7px}.field label .tag{color:#a02a3d;background:#fbedef;padding:3px 7px;border-radius:6px;font-size:11px;font-weight:800}.field input{display:block;width:100%;padding:13px 13px;border:1.5px solid #dfd6d5;border-radius:11px;background:#fff;color:#241b1c;outline:none;transition:border .15s,box-shadow .15s}.field input:focus{border-color:#ac2a40;box-shadow:0 0 0 4px #b6314618}.field input.invalid{border-color:#d32940;background:#fff6f7}.hint{font-size:11px;color:#82787b;margin-top:5px}.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.btn{padding:12px 17px;border-radius:10px;border:1px solid #e7d8da;font-weight:750;background:#fff;color:#831526}.btn.primary{background:#881a2c;border-color:#881a2c;color:white}.btn:hover{filter:brightness(.97)}.error{font-size:13px;color:#ad2438;background:#fff1f2;border:1px solid #f6c7cd;padding:10px 13px;border-radius:10px;margin-top:16px;display:none}.resultTop{padding:24px;background:linear-gradient(145deg,#741124,#a52d3d);color:white}.resultTop .topLabel{font-size:12px;letter-spacing:.08em;text-transform:uppercase;opacity:.8;font-weight:800}.resultTop .big{font-size:clamp(42px,6vw,62px);font-weight:900;letter-spacing:-.07em;line-height:1;margin:12px 0 8px}.status{display:inline-block;background:#ffffff2a;padding:7px 11px;border-radius:50px;font-size:12px;font-weight:800}.status.pass{background:#ffffff2a}.status.conditional{background:#fff1c4;color:#76510f}.status.fail{background:#ffe1e3;color:#ac253b}.resultTop p{font-size:12px;opacity:.86;line-height:1.5;margin:13px 0 0}.resultBody{padding:23px 23px 25px}.metric{display:flex;justify-content:space-between;align-items:baseline;gap:14px;margin:14px 0}.metric .l{color:#6f6668;font-size:13px}.metric .v{font-size:18px;font-weight:850;font-variant-numeric:tabular-nums}.metric small{color:#a29497;font-size:11px}.metric.major{padding:14px;background:#faf3f3;border-radius:11px}.metric.major .l{color:#681c2a;font-weight:750}.metric.major .v{color:#8a1b2f}.hr{height:1px;background:#eee6e4;margin:22px 0}.breakdown h3,.formula h3{font-size:14px;letter-spacing:-.01em;margin:0 0 15px}.barItem{margin:16px 0}.barLabel{display:flex;justify-content:space-between;gap:10px;font-size:12px;margin-bottom:7px}.barLabel strong{font-weight:800}.track{height:7px;border-radius:50px;background:#f0e7e5;overflow:hidden}.fill{height:100%;background:#a73446;width:0;transition:width .2s}.barDetail{font-size:11px;color:#8b8082;margin-top:5px}.formula{margin-top:20px;padding:18px;border:1px solid #e8dfe0;border-radius:15px;background:#fff}.formula p{font-size:12px;color:#6e6669;line-height:1.7;margin:9px 0}.formula code{color:#7b2030;background:#f8f1f2;padding:2px 5px;border-radius:4px;white-space:normal}.note{font-size:12px;color:#867b7f;line-height:1.65;margin:18px 0 0}.empty{display:none}.scale{margin-top:24px;background:#fff;border:1px solid #e9e1df;border-radius:17px;padding:21px 24px}.scale h3{margin:0 0 11px;font-size:16px}.scale p{font-size:13px;color:#74696c;line-height:1.65;margin:0}.scaleGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:15px}.scaleChip{padding:12px 7px;text-align:center;background:#f9f5f4;border-radius:9px;font-size:12px}.scaleChip strong{display:block;font-size:15px;color:#841b2b}.foot{margin-top:18px;text-align:center;color:#958a8c;font-size:11px}@media(max-width:800px){.layout{grid-template-columns:1fr}.topbar{padding:18px 22px}}@media(max-width:500px){main{padding:25px 14px 55px}.cardHeader,.body{padding-left:18px;padding-right:18px}.inputs{gap:12px}.scaleGrid{grid-template-columns:repeat(2,1fr)}.resultTop{padding:22px}.resultBody{padding:20px}}@media print{.topbar,.actions,.scale,.foot{display:none}main{padding:0}.layout{grid-template-columns:1fr 1fr}.card{box-shadow:none}body{background:white}}
.legendGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;margin-top:15px}.legendGrid>div{border:1px solid #f0e7e5;border-radius:10px;padding:12px;background:#fcf9f8;display:flex;gap:8px;flex-direction:column}.legendGrid strong{font-size:13px;color:#871b2d}.legendGrid span{font-size:12px;color:#61585b;line-height:1.4}@media(max-width:650px){.legendGrid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media print{.legendGrid{grid-template-columns:repeat(3,1fr)}}
</style>
</head>
<body>
<header class="topbar"><div class="logo">FG</div><div class="brand">Expected Grade Calculator<small>Student self-assessment tool</small></div></header>
<main>
<section class="intro"><div class="eyebrow">Estimate your standing</div><h1>Calculate your expected final grade.</h1><p>Enter your Canvas midterm grade and your finals scores. See the weighted computation, transmuted grade, and final grade equivalent as you type.</p></section>
<div class="layout">
<section class="card" aria-labelledby="entry-title"><div class="cardHeader"><div><h2 id="entry-title">Enter your grades</h2><p>Enter raw scores based on each assessment’s maximum points.</p></div></div><div class="body"><form id="gradeForm" novalidate>
<div class="sectionTitle">MIDTERM</div><div class="inputs"><div class="field"><label for="mg">Midterm Grade (MG) <span class="tag">Canvas</span></label><input id="mg" type="number" min="0" max="100" step="any" placeholder="e.g., 85" inputmode="decimal"/><div class="hint">Use your posted midterm grade.</div></div></div>
<div class="sectionTitle">FINALS: QUIZZES, EACH OUT OF 60 <span style="font-weight:500;color:#a09495">(40%)</span></div><div class="inputs"><div class="field"><label for="q1">Quiz 1 (Q1) <span class="tag">/60</span></label><input id="q1" type="number" min="0" max="60" step="any" placeholder="0 to 60" inputmode="decimal"/></div><div class="field"><label for="q2">Quiz 2 (Q2) <span class="tag">/60</span></label><input id="q2" type="number" min="0" max="60" step="any" placeholder="0 to 60" inputmode="decimal"/></div></div>
<div class="sectionTitle">FINALS: COURSEWORK, EACH OUT OF 50 <span style="font-weight:500;color:#a09495">(20%)</span></div><div class="inputs"><div class="field"><label for="cw1">Coursework 1 (CW1) <span class="tag">/50</span></label><input id="cw1" type="number" min="0" max="50" step="any" placeholder="0 to 50" inputmode="decimal"/></div><div class="field"><label for="cw2">Coursework 2 (CW2) <span class="tag">/50</span></label><input id="cw2" type="number" min="0" max="50" step="any" placeholder="0 to 50" inputmode="decimal"/></div><div class="field"><label for="cw3">Coursework 3 (CW3) <span class="tag">/50</span></label><input id="cw3" type="number" min="0" max="50" step="any" placeholder="0 to 50" inputmode="decimal"/></div></div>
<div class="sectionTitle">FINALS: OTHER COMPONENTS</div><div class="inputs"><div class="field"><label for="cs">Class Standing (CS) <span class="tag">/100 · 10%</span></label><input id="cs" type="number" min="0" max="100" step="any" placeholder="0 to 100" inputmode="decimal"/></div><div class="field"><label for="fe">Final Exam (FE) <span class="tag">/100 · 30%</span></label><input id="fe" type="number" min="0" max="100" step="any" placeholder="0 to 100" inputmode="decimal"/></div></div>
<div class="actions"><button class="btn primary" type="submit">Calculate grade</button><button class="btn" type="button" id="sample">Try sample values</button><button class="btn" type="reset">Clear all</button></div><div class="error" id="error" role="alert"></div>
</form></div></section>
<section aria-label="Calculation results"><div class="card"><div class="resultTop"><div class="topLabel">Equivalent Final Grade (EFG)</div><div class="big" id="efg">--</div><div class="status" id="status">Enter all eight grades</div><p id="statusNote">The estimate updates automatically when every field has a valid value.</p></div><div class="resultBody"><div class="metric"><span class="l">Raw Temporary Final Grade <small>(R_TFG)</small></span><span class="v" id="raw">--</span></div><div class="metric"><span class="l">Transmuted Final Grade <small>(T_TFG)</small></span><span class="v" id="trans">--</span></div><div class="metric major"><span class="l">Final Grade <small>(FG)</small></span><span class="v" id="fg">--</span></div><div class="hr"></div><div class="breakdown"><h3>Finals component breakdown</h3><div id="bars"></div></div></div></div>
<div class="formula"><h3>How it is calculated</h3><p><code>Q = ((Q1 + Q2) / 120) × 100</code><br><code>CW = ((CW1 + CW2 + CW3) / 150) × 100</code><br><small>Quiz scores are out of 60 each; coursework scores are out of 50 each. Both are normalized to 100% before weighting.</small></p><p><code>R_TFG = Q×0.40 + CW×0.20 + CS×0.10 + FE×0.30</code></p><p><code>T_TFG = ROUND(25 × (R_TFG − 60) / 40 + 75)</code></p><p><code>FG = (MG / 3) + (2 × T_TFG / 3)</code></p></div></section>
</div>
<section class="scale" aria-labelledby="legend-title"><h3 id="legend-title">Legend: Grade abbreviations</h3><div class="legendGrid">
<div><strong>Q</strong><span>Quizzes</span></div><div><strong>CW</strong><span>Courseworks</span></div><div><strong>CS</strong><span>Class Standing</span></div><div><strong>FE</strong><span>Final Exam</span></div><div><strong>R_TFG</strong><span>Raw Temporary Final Grade</span></div><div><strong>T_TFG</strong><span>Transmuted Final Grade</span></div><div><strong>FG</strong><span>Final Grade</span></div><div><strong>MG</strong><span>Midterm Grade</span></div><div><strong>EFG</strong><span>Equivalent Final Grade</span></div>
</div></section>
<div class="scale"><h3>Equivalent final grade scale</h3><p>The final percentage (FG) is rounded to the nearest whole number to find its equivalent. An FG of 70–74 is <strong>Conditional</strong>; below 70 is <strong>5.00 (Failed)</strong>.</p><div class="scaleGrid"><div class="scaleChip"><strong>1.00</strong>98–100</div><div class="scaleChip"><strong>1.25</strong>95–97</div><div class="scaleChip"><strong>1.50</strong>92–94</div><div class="scaleChip"><strong>1.75</strong>89–91</div><div class="scaleChip"><strong>2.00</strong>86–88</div><div class="scaleChip"><strong>2.25</strong>83–85</div><div class="scaleChip"><strong>2.50</strong>80–82</div><div class="scaleChip"><strong>2.75</strong>77–79</div><div class="scaleChip"><strong>3.00</strong>75–76</div><div class="scaleChip"><strong>Conditional</strong>70–74</div><div class="scaleChip"><strong>5.00</strong>Below 70</div></div></div>
<p class="foot">For estimation only. Official grades are determined by the instructor and applicable university policies. No entered data is uploaded or stored.</p>
</main>
<script>
(() => {
const ids=['mg','q1','q2','cw1','cw2','cw3','cs','fe'];
const maxScores={mg:100,q1:60,q2:60,cw1:50,cw2:50,cw3:50,cs:100,fe:100};
const $=id=>document.getElementById(id);
const fmt=x=>x.toFixed(2);
const gradeEquivalent=n=>{if(n>=98)return ['1.00','Passed'];if(n>=95)return ['1.25','Passed'];if(n>=92)return ['1.50','Passed'];if(n>=89)return ['1.75','Passed'];if(n>=86)return ['2.00','Passed'];if(n>=83)return ['2.25','Passed'];if(n>=80)return ['2.50','Passed'];if(n>=77)return ['2.75','Passed'];if(n>=75)return ['3.00','Passed'];if(n>=70)return ['Conditional','Conditional'];return ['5.00','Failed']};
const comps=[['Quizzes','Q','40%',0.4],['Coursework','CW','20%',0.2],['Class Standing','CS','10%',0.1],['Final Exam','FE','30%',0.3]];
function clearDisplay(){['efg','raw','trans','fg'].forEach(id=>$(id).textContent='--');$('status').textContent='Enter all eight grades';$('status').className='status';$('statusNote').textContent='The estimate updates automatically when every field has a valid value.';$('bars').innerHTML='';}
function calc(fromSubmit=false){let vals={};let missing=[];let invalid=[];for(const id of ids){const el=$(id),s=el.value.trim(),n=Number(s);el.classList.remove('invalid');if(s===''){missing.push(id);if(fromSubmit)el.classList.add('invalid')}else if(!Number.isFinite(n)||n<0||n>maxScores[id]){invalid.push(id);el.classList.add('invalid')}else vals[id]=n;}
const err=$('error');if(invalid.length|| (fromSubmit&&missing.length)){err.style.display='block';err.textContent= invalid.length?'Check the highlighted scores: quizzes must be 0–60, coursework 0–50, and MG, CS, and FE 0–100.':'Please complete all eight grade fields to calculate your expected grade.';}else{err.style.display='none';err.textContent='';}
if(invalid.length||missing.length){clearDisplay();if(invalid.length){$('status').textContent='Check entered grades';$('statusNote').textContent='Quiz maximum: 60; coursework maximum: 50; other grades maximum: 100.';}return;}
const q=(vals.q1+vals.q2)/120*100,cw=(vals.cw1+vals.cw2+vals.cw3)/150*100;
const scores=[q,cw,vals.cs,vals.fe];const raw=scores.reduce((sum,s,i)=>sum+s*comps[i][3],0);
// JavaScript Math.round matches spreadsheet ROUND for these nonnegative transmuted results.
const trans=Math.round(25*(raw-60)/40+75);
const fg=vals.mg/3+trans*2/3;
const rounded=Math.round(fg);
const [efg,status]=gradeEquivalent(rounded);
$('efg').textContent=efg;$('raw').textContent=fmt(raw);$('trans').textContent=String(trans);$('fg').textContent=fmt(fg);
$('status').textContent=status;$('status').className='status '+(status==='Failed'?'fail':status==='Conditional'?'conditional':'pass');
$('statusNote').textContent='Grade scale lookup uses rounded FG = '+rounded+'. This is an estimate, not an official grade.';
$('bars').innerHTML=comps.map((c,i)=>{const weight=scores[i]*c[3];return `<div class="barItem"><div class="barLabel"><span>${c[0]} (${c[2]})</span><strong>${fmt(weight)} pts</strong></div><div class="track"><div class="fill" style="width:${scores[i]}%"></div></div><div class="barDetail">Normalized score: ${fmt(scores[i])}% × ${c[2]}</div></div>`;}).join('');
}
$('gradeForm').addEventListener('input',()=>calc());$('gradeForm').addEventListener('submit',e=>{e.preventDefault();calc(true);if($('error').style.display==='none'&&innerWidth<800)document.querySelector('.resultTop').scrollIntoView({behavior:'smooth',block:'start'});});$('gradeForm').addEventListener('reset',()=>{setTimeout(()=>{ids.forEach(id=>$(id).classList.remove('invalid'));$('error').style.display='none';clearDisplay();},0)});
$('sample').addEventListener('click',()=>{const sample={mg:85,q1:54,q2:48,cw1:45,cw2:42,cw3:47,cs:88,fe:84};for(const [k,v] of Object.entries(sample))$(k).value=v;calc();});clearDisplay();
})();
</script>
</body>
</html>
